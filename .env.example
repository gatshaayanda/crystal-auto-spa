# Crystal Auto Spa environment example.
# Public Firebase web configuration for the owner-selected recycled Atlas project.
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_FIREBASE_EMULATOR=false
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=atlas-service-centre
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Server-only Firebase service account JSON. Keep credentials in deployment secrets.
FIREBASE_ADMIN_KEY=
FIREBASE_PROJECT_ID=atlas-service-centre
ADMIN_PASSWORD=
CRYSTAL_AUTO_SPA_REMINDER_CRON_SECRET=

# UploadThing server token. Media uploads use UploadThing, not Firebase Storage.
UPLOADTHING_TOKEN=
